# For local testing only. On GitHub Actions, set these as repository Secrets
# instead (Settings -> Secrets and variables -> Actions) — never commit a real .env.

# Required — Claude API key, used to generate outreach messages
ANTHROPIC_API_KEY=

# Required — Gmail address the digest is sent from
GMAIL_ADDRESS=

# Required — Gmail App Password (NOT your normal Gmail password)
# Generate one at https://myaccount.google.com/apppasswords (needs 2-Step Verification enabled)
GMAIL_APP_PASSWORD=

# Required — where the daily digest email gets sent
RECIPIENT_EMAIL=

# Optional — Hunter.io API key, used to look up each founder's work email
HUNTER_API_KEY=

# Optional — Exa API key (exa.ai), used to research the best-fit founder for
# each new role (recent public activity, competitors, a real account signal)
# before drafting their message. Only runs for the one founder flagged as
# best-fit, and every fact it pulls is verified before use. Skip this entirely
# to keep the lighter-weight, one-liner-based message generation.
EXA_API_KEY=
